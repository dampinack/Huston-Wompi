# ============================================================================
# WOMPI PANAMA - CONFIGURACION DE AMBIENTE (HUSTON ASSETS S.A.)
# ============================================================================

# Puerto del microservicio de pasarela
PORT=3000

# Ambiente activo: "sandbox" (pruebas sin dinero real) o "production" (dinero real)
WOMPI_ENV=sandbox

# --- CREDENCIALES SANDBOX (Obtener activando "Modo de pruebas" en comercios.wompi.pa/developers) ---
WOMPI_TEST_PUBLIC_KEY=pub_test_REEMPLAZAR_CON_LLAVE_PRUEBAS
WOMPI_TEST_PRIVATE_KEY=prv_test_REEMPLAZAR_CON_LLAVE_PRIVADA_PRUEBAS
WOMPI_TEST_INTEGRITY_SECRET=test_integrity_REEMPLAZAR_CON_SECRETO_INTEGRIDAD_PRUEBAS
WOMPI_TEST_EVENTS_SECRET=test_events_REEMPLAZAR_CON_SECRETO_EVENTOS_PRUEBAS
WOMPI_TEST_API_URL=https://api-sandbox.wompi.pa/v1

# --- CREDENCIALES PRODUCCION (HUSTON ASSETS S.A.) ---
WOMPI_PROD_PUBLIC_KEY=pub_prod_0vsGidrn72wbGthE9BTTac9P3BXNqat7
WOMPI_PROD_PRIVATE_KEY=prv_prod_REEMPLAZAR_AQUI_NUNCA_SUBIR_A_GIT
WOMPI_PROD_INTEGRITY_SECRET=prod_integrity_REEMPLAZAR_AQUI_NUNCA_SUBIR_A_GIT
WOMPI_PROD_EVENTS_SECRET=prod_events_REEMPLAZAR_AQUI_NUNCA_SUBIR_A_GIT
WOMPI_PROD_API_URL=https://api.wompi.pa/v1

# --- SEGURIDAD INTERNA ENTRE TU WEB/TIENDA EXISTENTE Y ESTE MICROSERVICIO ---
# API Key compartida entre tu tienda/web principal y este microservicio para crear ordenes
INTERNAL_GATEWAY_API_KEY=cambiar_por_token_interno_seguro_64_chars
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# URL publica a donde Wompi redirigira al comprador tras finalizar en el checkout
DEFAULT_REDIRECT_URL=http://localhost:3000/checkout/result

# Ruta de base de datos local SQLite (para persistencia transaccional y auditoria de webhooks)
SQLITE_DB_PATH=./data/wompi_gateway.sqlite
